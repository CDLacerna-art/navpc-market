# NavPC Market — Environment Configuration

# 1. Supabase Connection (Public Anon Client)
# Note: Never expose SUPABASE_SERVICE_ROLE_KEY in frontend client code.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 2. Local Campus Demo Switcher Flag
# When 'true', allows the top demo persona banner for local offline presentations.
# When 'false' or omitted, the demo role switcher is disabled and real auth sessions are strictly required.
VITE_ENABLE_DEMO_MODE=false
