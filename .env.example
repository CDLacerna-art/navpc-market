# Supabase Configuration for NavPC Market
# When these values are provided, the application connects directly to your live Supabase project.
# When omitted or empty, the application seamlessly activates the built-in Local Campus Demo Engine
# so students and reviewers can evaluate all flows without interruption.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Note: Never expose SUPABASE_SERVICE_ROLE_KEY on the client side.
